# PDE @ IDX - Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control (it's in .gitignore).

# --- Database ---
# Format: mysql:host=<host>;dbname=<dbname>
DB_DSN=mysql:host=localhost;dbname=pde
DB_USERNAME=root
DB_PASSWORD=

# --- Application ---
# The current web entry point defines YII_DEBUG=false and YII_ENV=prod.
# These values are examples for a future environment-aware bootstrap; this
# project does not load .env automatically.
YII_DEBUG=1
YII_ENV=dev

# --- Mailer (optional) ---
# When not empty, emails are sent via SMTP instead of file transport
# MAILER_TRANSPORT=smtp
# MAILER_HOST=mail.example.com
# MAILER_PORT=587
# MAILER_USERNAME=
# MAILER_PASSWORD=
