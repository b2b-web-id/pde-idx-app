# PDE @ IDX - Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control (it's in .gitignore).

# --- Database ---
# Format: mysql:host=<host>;dbname=<dbname>
DB_DSN=mysql:host=localhost;dbname=yii2basic
DB_USERNAME=root
DB_PASSWORD=

# --- Application ---
# Set to 1 for development, 0 for production
# When YII_DEBUG=0, error messages are hidden from users
YII_DEBUG=1
# dev | prod
YII_ENV=dev

# --- Mailer (optional) ---
# When not empty, emails are sent via SMTP instead of file transport
# MAILER_TRANSPORT=smtp
# MAILER_HOST=mail.example.com
# MAILER_PORT=587
# MAILER_USERNAME=
# MAILER_PASSWORD=
